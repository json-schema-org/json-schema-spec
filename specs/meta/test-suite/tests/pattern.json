{
  "$schema": "../test-suite.schema.json",

  "description": "Tests for the pattern keyword",
  "tests": [
    {
      "description": "Valid regex string",
      "schema": {
        "$schema": "https://json-schema.org/v1",
        "pattern": "^[a-z]+$"
      },
      "valid": true
    },
    {
      "description": "Invalid ECMA-262 regex string is still allowed",
      "schema": {
        "$schema": "https://json-schema.org/v1",
        "pattern": "("
      },
      "valid": true
    },
    {
      "description": "Non-string pattern is invalid",
      "schema": {
        "$schema": "https://json-schema.org/v1",
        "pattern": 42
      },
      "valid": false
    }
  ]
}
