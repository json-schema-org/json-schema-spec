{
  "$schema": "https://json-schema.org/v1",
  "$id": "https://json-schema.org/v1/2026/output/schema",
  "description": "A schema that validates the minimum requirements for validation output",

  "properties": {
    "valid": { "type": "boolean" },
    "evaluationPath": { "type": "string", "format": "json-pointer" },
    "schemaLocation": { "type": "string", "format": "uri" },
    "instanceLocation": { "type": "string", "format": "json-pointer" },
    "details": { "$ref": "#/$defs/outputUnitArray" },
    "annotations": { "type": "object", "additionalProperties": true },
    "droppedAnnotations": { "type": "object", "additionalProperties": true },
    "errors": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [ { "required": [ "errors" ] }, { "required": [ "droppedAnnotations" ] } ]
      },
      "then": { "properties": { "valid": { "const": false } } }
    },
    {
      "if": { "required": [ "annotations" ] },
      "then": { "properties": { "valid": { "const": true } } }
    }
  ],
  "anyOf": [
    { "$ref": "#/$defs/flag" },
    { "$ref": "#/$defs/list" },
    { "$ref": "#/$defs/hierarchical" }
  ],
  "$defs": {
    "rootOutputUnit": {
      "type": "object",
      "required": [ "valid" ],
      "allOf": [
        { "$ref": "#/$defs/outputUnitProperties" },
        {
          "if": { "anyOf": [ { "required": [ "errors" ] }, { "required": [ "droppedAnnotations" ] } ] },
          "then": { "properties": { "valid": { "const": false } } }
        },
        {
          "if": { "required": [ "annotations" ] },
          "then": { "properties": { "valid": { "const": true } } }
        }
      ]
    },
    "outputUnit": {
      "allOf": [
        { "$ref": "#/$defs/rootOutputUnit" },
        { "required": [ "evaluationPath", "schemaLocation", "instanceLocation" ] }
      ]
    },
    "outputUnitArray": {
      "type": "array",
      "items": { "$ref": "#/$defs/outputUnit" }
    },
    "outputUnitProperties": {
      "properties": {
        "valid": { "type": "boolean" },
        "evaluationPath": { "type": "string", "format": "json-pointer" },
        "schemaLocation": { "type": "string", "format": "uri" },
        "instanceLocation": { "type": "string", "format": "json-pointer" },
        "details": { "$ref": "#/$defs/outputUnitArray" },
        "annotations": { "type": "object", "additionalProperties": true },
        "droppedAnnotations": { "type": "object", "additionalProperties": true },
        "errors": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "flag": {
      "type": "object",
      "required": [ "valid" ],
      "allOf": [ { "$ref": "#/$defs/outputUnitProperties" } ]
    },
    "list": {
      "type": "object",
      "required": [ "valid", "details" ],
      "allOf": [ { "$ref": "#/$defs/outputUnitProperties" } ]
    },
    "hierarchical": {
      "allOf": [
        { "$ref": "#/$defs/rootOutputUnit" },
        {
          "anyOf": [
            { "required": [ "evaluationPath", "schemaLocation", "instanceLocation" ] },
            { "required": [ "details" ] },
            { "required": [ "annotations" ] },
            { "required": [ "droppedAnnotations" ] },
            { "required": [ "errors" ] }
          ]
        }
      ]
    }
  }
}
